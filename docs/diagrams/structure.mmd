classDiagram
    direction TB

    class Main {
        +main()
    }

    class Menu {
        -protectionService ProtectionService
        -verificationService VerificationService
        -presenter Presenter
        -generator EventGenerator
        -session Session
        +Run() error
    }

    class Session {
        +Events []Event
        -protectedLogID string
        -verified bool
    }

    class Presenter {
        +PresentGeneratedEvents(events []Event) error
        +PresentProtection(res ProtectionResult) error
        +PresentReport(rep Report) error
    }

    class ProtectionService {
        <<interface>>
        +Protect(events []Event) (ProtectionResult, error)
    }

    class VerificationService {
        <<interface>>
        +Verify() (Report, error)
    }

    class ProtectionResult {
        +string LogID
        +int EventCount
        +map~EventType,int~ EventsByType
        +string PlainLogHash
        +string EncryptedLogHash
        +string[] ArtifactFiles
    }

    class protectionService {
        -hasher Hasher
        -encryptor Encryptor
        -store ArtifactStore
        -now func() Time
        -newID func() (string, error)
        +Protect(events []Event) (ProtectionResult, error)
    }

    class verificationService {
        -hasher Hasher
        -encryptor Encryptor
        -store ArtifactStore
        +Verify() (Report, error)
    }

    class Event {
        +string EventID
        +EventType EventType
        +string Timestamp
        +string ActorUID
        +string StudentUID
        +string CourseUID
        +*float64 Grade
        +*float64 PreviousGrade
        +*float64 NewGrade
        +string PayloadHash
    }

    class Log {
        +string LogID
        +string Version
        +string GeneratedAt
        +int EventCount
        +Event[] Events
    }

    class Report {
        +string LogID
        +int EventCount
        +map~EventType,int~ EventsByType
        +string PlainLogHash
        +string EncryptedLogHash
        +string DecryptedLogHash
        +bool IntegrityPreserved
        +string Details
    }

    class Hasher {
        <<interface>>
        +HashHex(data []byte) string
    }

    class Encryptor {
        <<interface>>
        +GenerateKey() ([]byte, error)
        +Encrypt(key []byte, plaintext []byte) ([]byte, error)
        +Decrypt(key []byte, data []byte) ([]byte, error)
    }

    class SHA256Hasher {
        +HashHex(data []byte) string
    }

    class AESGCMEncryptor {
        +GenerateKey() ([]byte, error)
        +Encrypt(key []byte, plaintext []byte) ([]byte, error)
        +Decrypt(key []byte, data []byte) ([]byte, error)
    }

    class EventGenerator {
        <<interface>>
        +Generate(n int) ([]Event, error)
    }

    class RandomEventGenerator {
        -rng *Rand
        -now func() Time
        -newID func() (string, error)
        +Generate(n int) ([]Event, error)
    }

    class ArtifactStore {
        <<interface>>
        +Save(name string, data []byte, perm FileMode) error
        +Load(name string) ([]byte, error)
    }

    class FileStore {
        -string baseDir
        +Save(name string, data []byte, perm FileMode) error
        +Load(name string) ([]byte, error)
    }

    Main ..> Menu : inicializa
    Main ..> SHA256Hasher : instancia
    Main ..> AESGCMEncryptor : instancia
    Main ..> FileStore : instancia
    Main ..> RandomEventGenerator : instancia
    Main ..> protectionService : instancia
    Main ..> verificationService : instancia

    Menu --> ProtectionService : invoca
    Menu --> VerificationService : invoca
    Menu --> EventGenerator : invoca
    Menu --> Presenter : usa
    Menu *-- Session : contiene

    protectionService ..|> ProtectionService : implementa
    protectionService --> Hasher : depende
    protectionService --> Encryptor : depende
    protectionService --> ArtifactStore : depende

    verificationService ..|> VerificationService : implementa
    verificationService --> Hasher : depende
    verificationService --> Encryptor : depende
    verificationService --> ArtifactStore : depende


    SHA256Hasher ..|> Hasher : implementa
    AESGCMEncryptor ..|> Encryptor : implementa
    FileStore ..|> ArtifactStore : implementa
    RandomEventGenerator ..|> EventGenerator : implementa
